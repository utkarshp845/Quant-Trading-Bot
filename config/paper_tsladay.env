BOT_PROFILE=paper
SYMBOL=TSLA
IS_CRYPTO=false
ALPACA_PAPER=true
STRATEGY_VERSION=v1-tsla-day
RESEARCH_STARTING_EQUITY=150
RESEARCH_OUTPUT_STEM=research_paper_tsladay

# Same-day-only intraday trend/momentum on TSLA, 15m bars, both directions.
# Built because the swing config (config/paper_spy.env, ~1 trade/2 weeks)
# doesn't capture TSLA's frequent intraday up/down swings by design. Paper
# rehearsal mirrors config/live_tsladay.env exactly. Keep the two in sync.
#
# Backtest (bot/optimize_strategy.py walk-forward, 60 trading days of 15m
# bars via yfinance, 2026-05-11..2026-08-05 - Alpaca keys live on EC2 only,
# free intraday history is capped at ~60 days so this is a MUCH thinner
# validation than the swing config's 2.9-year backtest, one market regime
# only):
#   55 trades (30 short / 25 long), win rate 53%. At this sizing (65%/70%
#   target/max notional): net +$20.01 (+13.3%) on $150, PF 2.01 (1.99 under
#   2x slippage), max drawdown 3.7%. Walk-forward: positive in 3 of 4
#   out-of-sample test windows. Full methodology and
#   caveats: docs/strategy_tsla_day_2026-08.md.
TIMEFRAME_MINUTES=15

# Flat by close every day, always - this is the entire point of the design.
# Capped at 1 round trip/day: with $150 cash and T+1 settlement, more than
# one buy+sell cycle/day risks reusing unsettled proceeds -> a good-faith
# violation (3 in a rolling 12mo gets the account restricted to settled-cash
# trading for 90 days). This is an account-mechanics limit, not a signal
# choice - do not raise it without funding separate settled-cash tranches.
ALLOW_OVERNIGHT_HOLDING=false
FLATTEN_BEFORE_CLOSE_MINUTES=15
MAX_TRADES_PER_DAY=1

# Bidirectional: a same-day flatten-by-close position carries no overnight
# gap risk, so (unlike the swing config) shorting TSLA's down-swings is
# fair game and backtested about as profitable as the long side.
ALLOW_SHORTS=true
# Skip the first 15m (opening-range noise/wide spreads) and stop opening new
# trades 30m before the flatten window so a fresh entry has time to develop.
ENTRY_WINDOWS=0945-1530
LONG_ENTRY_WINDOWS=0945-1530
SHORT_ENTRY_WINDOWS=0945-1530

# Fractional, notional-based sizing. Deliberately trimmed below what the
# 60-day backtest could have supported (single-trade risk there was small,
# max historical loss ~1.6% of equity) as a margin of safety: this strategy
# has one market regime of evidence, not the swing config's three years.
ALLOW_FRACTIONAL_EQUITIES=true
POSITION_SIZING_MODE=notional_cap
MAX_POSITION_NOTIONAL_PCT=0.70
TARGET_POSITION_NOTIONAL_PCT=0.65
MIN_ORDER_NOTIONAL=5.0

# Exits: tight ATR stop and short time cap - by design this should rarely
# reach the flatten window at all; that's a backstop, not the primary exit.
HARD_STOP_ATR_MULT=1.5
TRAIL_AFTER_ATR_MULTIPLE=1.0
TRAIL_ATR_MULTIPLIER=1.2
MAX_BARS_IN_TRADE=8
EXIT_ON_REGIME_INVALIDATION=true
ENABLE_BREAKEVEN_STOP=false
ENABLE_PROFIT_LOCK=false

# Core signal: SMA8>SMA34 (or inverse for shorts), ADX(14)>=15, 15m ATR% capped
# at 1.6%, both sides use the same thresholds (kept symmetric deliberately -
# only 60 days of data to fit on, fewer free parameters = less overfit risk).
SMA_FAST=8
SMA_SLOW=34
EXEC_TREND_EMA_PERIOD=34
ADX_THRESHOLD=15
LONG_ADX_THRESHOLD=15
SHORT_ADX_THRESHOLD=15
ATR_MAX_PCT=0.016
LONG_ATR_MAX_PCT=0.016
SHORT_ATR_MAX_PCT=0.016
LONG_MIN_TREND_EMA_DISTANCE_PCT=0
SHORT_MIN_TREND_EMA_DISTANCE_PCT=0

# Micro-filters off - not part of the grid search, left at pass-through so
# they can't silently veto trades the optimizer never accounted for.
MIN_VOLUME_RATIO=0
VOLUME_MIN_MULTIPLIER=0
MOMENTUM_LOOKBACK_BARS=0
MIN_SMA_SPREAD_ATR_MULT=0
MIN_ADX_DELTA=0
PULLBACK_MIN_DEPTH_ATR=0
PULLBACK_MAX_DEPTH_ATR=99
REACCEL_MIN_BAR_BODY_ATR=0
SPIKE_BAR_MAX_RANGE_ATR=10

# "Regime" here is a 2-hour intraday trend gate (confirms the session's
# direction before taking the 15m signal), not the swing config's daily-EMA
# gate - a multi-day lookback doesn't fit a same-day strategy.
REGIME_TIMEFRAME_MINUTES=120
REGIME_EMA_PERIOD=10
REGIME_ADX_PERIOD=14
REGIME_ADX_MIN=0
REGIME_SLOPE_LOOKBACK_BARS=3
REGIME_MIN_SLOPE_PCT=0
REGIME_ATR_MAX_PCT=1.0

# Risk limits: single position at a time, 1 trade/day hard cap (see above),
# tight consecutive-loss/daily-loss circuit breakers since a bad session can
# otherwise chain multiple losing days before anyone notices.
MAX_DAILY_DRAWDOWN_PCT=0.05
MAX_DAILY_LOSS=8
MAX_CONSECUTIVE_LOSSES=3
MAX_CONSECUTIVE_ENTRY_FAILURES_PER_DAY=3
COOLDOWN_BARS=0
REENTRY_REQUIRES_SIGNAL_STRENGTH_IMPROVEMENT=false

# 15m bars: allow up to 2 bars of age before calling data stale. Needs a
# tighter cron cadence than the hourly swing profile to be useful intraday.
ENABLE_STALE_BAR_CHECK=true
MAX_BAR_AGE_SECONDS=1800
