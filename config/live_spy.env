BOT_PROFILE=live
SYMBOL=TSLA
IS_CRYPTO=false
ALPACA_PAPER=false
STRATEGY_VERSION=v4-tsla-trend

# Hourly trend-following on TSLA. Backtested via yfinance hourly bars (Alpaca
# keys live only on EC2, not here) over 2023-09..2026-08, walk-forward
# validated (13 windows, 120d train / 45d test): net +$32.97 (+22%) on $150,
# PF 1.56 (1.55 under 2x slippage), 28 trades (~9/yr), max DD 9.4%. See
# docs/strategy_tsla_2026-08.md for the full evidence and caveats.
# IMPORTANT: most of the backtested profit came from the 2024 rally leg
# (+$52); 2023/2025/2026 were each roughly flat-to-slightly-negative. This is
# a lower-frequency, lumpier edge than the QQQ v3 config it replaces, not a
# guaranteed win -- run paper alongside live and compare fills before trusting
# it fully.
TIMEFRAME_MINUTES=60

# Multi-day trend holds are the whole edge — do NOT flatten daily.
ALLOW_OVERNIGHT_HOLDING=true
FLATTEN_BEFORE_CLOSE_MINUTES=0
ENTRY_WINDOWS=0000-2359
LONG_ENTRY_WINDOWS=0000-2359
SHORT_ENTRY_WINDOWS=0000-2359
ALLOW_SHORTS=false

# TSLA's hourly ATR% runs ~3x QQQ's (median ~1.4% vs ~0.49%), so position
# size is trimmed from QQQ's ~90% notional to ~60% -- that's what kept
# backtested max drawdown under the 10% risk cap (90% sizing on the same
# signal pushed DD to ~14%).
ALLOW_FRACTIONAL_EQUITIES=true
POSITION_SIZING_MODE=notional_cap
MAX_POSITION_NOTIONAL_PCT=0.65
TARGET_POSITION_NOTIONAL_PCT=0.60
MIN_ORDER_NOTIONAL=5.0

# Exits: hard stop caps single-trade loss at ~2.5 hourly ATRs; trail starts
# after 1.5x ATR of favorable move and gives back up to 2x ATR of gain.
HARD_STOP_ATR_MULT=2.5
TRAIL_AFTER_ATR_MULTIPLE=1.5
TRAIL_ATR_MULTIPLIER=2.0
MAX_BARS_IN_TRADE=48
EXIT_ON_REGIME_INVALIDATION=true
ENABLE_BREAKEVEN_STOP=false
BREAKEVEN_AFTER_ATR_MULTIPLE=1.0
ENABLE_PROFIT_LOCK=false
PROFIT_LOCK_AFTER_ATR_MULTIPLE=2.0
PROFIT_LOCK_ATR_MULTIPLE=0.5

# Core signal: SMA8>SMA30 (faster than QQQ's 20/50 -- TSLA trends move and
# reverse faster than an index), price above EMA55, bullish confirmation bar,
# and the daily regime (close above 20-day EMA, rising) must be on.
SMA_FAST=8
SMA_SLOW=30
EXEC_TREND_EMA_PERIOD=55
ADX_THRESHOLD=18
LONG_ADX_THRESHOLD=20
ATR_MAX_PCT=0.020
LONG_ATR_MAX_PCT=0.020
LONG_MIN_TREND_EMA_DISTANCE_PCT=0
SHORT_MIN_TREND_EMA_DISTANCE_PCT=0

# Unlike QQQ's fully-off micro-filter set, these mattered in TSLA backtest:
# minimum volume vs its 20-bar average, a shallow pullback requirement before
# entry, and a spike-bar cutoff that skips the most violent single-hour bars.
MIN_VOLUME_RATIO=0.8
VOLUME_MIN_MULTIPLIER=0
MOMENTUM_LOOKBACK_BARS=0
MIN_SMA_SPREAD_ATR_MULT=0
MIN_ADX_DELTA=0
PULLBACK_MIN_DEPTH_ATR=0.1
PULLBACK_MAX_DEPTH_ATR=2.0
REACCEL_MIN_BAR_BODY_ATR=0
SPIKE_BAR_MAX_RANGE_ATR=2.5

# Regime: daily bars, price above 20-day EMA and rising >=0.1% per 3 days.
# ADX-strength sub-requirement stays off (REGIME_ADX_MIN=0, same as QQQ) --
# TSLA's daily ADX is too noisy for that filter to be useful.
REGIME_TIMEFRAME_MINUTES=1440
REGIME_EMA_PERIOD=20
REGIME_ADX_PERIOD=14
REGIME_ADX_MIN=0
REGIME_SLOPE_LOOKBACK_BARS=3
REGIME_MIN_SLOPE_PCT=0.001
REGIME_ATR_MAX_PCT=1.0

# Risk limits: cash account, ~1 entry every 1-2 weeks expected (lower cadence
# than QQQ's ~2/week), holds of days.
MAX_DAILY_DRAWDOWN_PCT=0.04
MAX_DAILY_LOSS=6
MAX_CONSECUTIVE_LOSSES=3
MAX_TRADES_PER_DAY=2
MAX_CONSECUTIVE_ENTRY_FAILURES_PER_DAY=3
COOLDOWN_BARS=4
REENTRY_REQUIRES_SIGNAL_STRENGTH_IMPROVEMENT=false

# Hourly bars: allow up to 1.5 bars of age before calling data stale.
ENABLE_STALE_BAR_CHECK=true
MAX_BAR_AGE_SECONDS=5400
