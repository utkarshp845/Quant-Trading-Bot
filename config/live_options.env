BOT_PROFILE=live
BOT_MARKET=options
IS_OPTIONS=true
IS_CRYPTO=false
ALPACA_PAPER=false
STRATEGY_VERSION=v1-options-nvda-tsla
OPTION_SYMBOLS=NVDA,TSLA
# Not read by bot/options_engine.py (sizing uses OPTION_MAX_PREMIUM_PCT_OF_EQUITY
# instead) — set only so bot/validate_profile_env.py's generic profile-contract
# check (which expects every profile to declare a sizing mode) still passes.
POSITION_SIZING_MODE=notional_cap

# NOT RECOMMENDED YET. This file exists so the live path is ready, but this
# strategy has no paper-trading track record yet — run `paper-options` for a
# real stretch first, the same standard already applied to `tsladay` before
# it's trusted with the equity path. See docs/strategy_options_2026-08.md.
#
# Options trading must also be enabled on the Alpaca LIVE account in
# Alpaca's own dashboard first (a separate approval from paper) — this file
# can't grant that.
TIMEFRAME_MINUTES=60

# Multi-day holds, same as the equity TSLA profile this signal is seeded
# from — the whole edge is riding a trend for days, not minutes.
ALLOW_OVERNIGHT_HOLDING=true
FLATTEN_BEFORE_CLOSE_MINUTES=0
ENTRY_WINDOWS=0000-2359
LONG_ENTRY_WINDOWS=0000-2359
SHORT_ENTRY_WINDOWS=0000-2359

# Unlike the equity profiles: shorts are ENABLED here. A long put has the
# same bounded risk (premium only) as a long call, so there's no need to
# suppress the short side the way ALLOW_SHORTS=false does for naked stock
# shorting on a small cash account.
ALLOW_SHORTS=true

# --- Contract selection (the actual strategy lever — see
# docs/strategy_options_2026-08.md) ---
# Moderate delta: the contract should move close to dollar-for-dollar with
# the stock, so the underlying's real (modest) trend edge actually
# transfers, instead of buying a cheap far-OTM option dominated by IV/theta.
OPTION_TARGET_DELTA=0.65
OPTION_DELTA_TOLERANCE=0.15
# 30-45 DTE at entry; force-close/exit once only OPTION_EXIT_MIN_DTE calendar
# days remain, well before the theta/gamma cliff in an option's final
# one-to-two weeks.
OPTION_MIN_DTE=25
OPTION_MAX_DTE=45
OPTION_EXIT_MIN_DTE=12
# Skip any contract whose bid-ask spread exceeds this fraction of its mid —
# the options analog of the BTC round-trip-fee lesson: friction that looks
# small per-trade can exceed the whole edge.
OPTION_MAX_BID_ASK_SPREAD_PCT=0.08
# Operator-maintained: comma-separated ISO dates of known/expected NVDA and
# TSLA earnings. No new entries within OPTION_EARNINGS_BLACKOUT_DAYS of any
# listed date. Update this each quarter — it is NOT pulled from a live feed.
OPTION_EARNINGS_BLACKOUT_DAYS=3
OPTION_EARNINGS_BLACKOUT_DATES=

# --- Sizing / concurrency (~$500 starting account) ---
# At most one options position open at a time, across BOTH symbols combined
# — see bot/options_engine.py. Premium budget per trade is capped well
# under 100% of equity on purpose: leaves a buffer instead of betting the
# whole account on one contract, and this account size will often simply
# have no affordable contract in the target delta/DTE band — expect this to
# trade rarely at first. That's intentional, not a bug; see
# docs/strategy_options_2026-08.md.
OPTION_MAX_CONCURRENT_POSITIONS=1
OPTION_MAX_PREMIUM_PCT_OF_EQUITY=0.55

# --- Core signal: identical shape to config/live_spy.env's TSLA trend
# signal (SMA8>SMA30, price above EMA55, daily-EMA regime filter) ---
SMA_FAST=8
SMA_SLOW=30
EXEC_TREND_EMA_PERIOD=55
ADX_THRESHOLD=18
LONG_ADX_THRESHOLD=20
SHORT_ADX_THRESHOLD=20
ATR_MAX_PCT=0.020
LONG_ATR_MAX_PCT=0.020
SHORT_ATR_MAX_PCT=0.020

MIN_VOLUME_RATIO=0.8
VOLUME_MIN_MULTIPLIER=0
MOMENTUM_LOOKBACK_BARS=0
MIN_SMA_SPREAD_ATR_MULT=0
MIN_ADX_DELTA=0
PULLBACK_MIN_DEPTH_ATR=0.1
PULLBACK_MAX_DEPTH_ATR=2.0
REACCEL_MIN_BAR_BODY_ATR=0
SPIKE_BAR_MAX_RANGE_ATR=2.5

REGIME_TIMEFRAME_MINUTES=1440
REGIME_EMA_PERIOD=20
REGIME_ADX_PERIOD=14
REGIME_ADX_MIN=0
REGIME_SLOPE_LOOKBACK_BARS=3
REGIME_MIN_SLOPE_PCT=0.001
REGIME_ATR_MAX_PCT=1.0

# --- Exits (underlying-price-based; identical shape to the equity profile) ---
HARD_STOP_ATR_MULT=2.5
TRAIL_AFTER_ATR_MULTIPLE=1.5
TRAIL_ATR_MULTIPLIER=2.0
MAX_BARS_IN_TRADE=48
EXIT_ON_REGIME_INVALIDATION=true

# --- Account-level risk limits ---
MAX_DAILY_DRAWDOWN_PCT=0.05
MAX_DAILY_LOSS=25
MAX_CONSECUTIVE_LOSSES=3
MAX_TRADES_PER_DAY=2
MAX_CONSECUTIVE_ENTRY_FAILURES_PER_DAY=3
COOLDOWN_BARS=4

ENABLE_STALE_BAR_CHECK=true
MAX_BAR_AGE_SECONDS=5400

# --- Research/replay (modeled, Black-Scholes-based — see
# docs/strategy_options_2026-08.md before trusting these numbers) ---
RESEARCH_STARTING_EQUITY=500
RESEARCH_LOOKBACK_DAYS=365
OPTION_IV_LOOKBACK_DAYS=20
OPTION_IV_FLOOR=0.25
OPTION_IV_FALLBACK=0.45
